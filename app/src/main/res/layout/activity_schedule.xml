                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="화" android:textStyle="bold" android:background="@drawable/cell_border" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="수" android:textStyle="bold" android:background="@drawable/cell_border" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="목" android:textStyle="bold" android:background="@drawable/cell_border" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_weight="1" android:text="금" android:textStyle="bold" android:background="@drawable/cell_border" android:gravity="center"/>
            </TableRow>

