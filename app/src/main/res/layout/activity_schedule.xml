                    android:layout_height="wrap_content"
                    android:text="알람 On/Off"
                    android:textSize="12sp"
                    android:textColor="#000000"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 홈 버튼 -->
